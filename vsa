function isTPTargetAlive(target)
    if not target or not target.Parent or not target.Character then return false end
    local hum = target.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not TPConfig.FollowEvenIfKO then
        local be = target.Character:FindFirstChild("BodyEffects")
        if be then
            local ko = be:FindFirstChild("K.O")
            if ko and ko.Value then return false end
        end
    end
    return true
end

function saveTPReturnPosition()
    local myHRP = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if myHRP then
        TPConfig.SavedPosition = myHRP.CFrame
    end
end

function safeTpStep(myHRP, destCF)
    if not myHRP or not myHRP.Parent then return end
    local curPos  = myHRP.Position
    local destPos = destCF.Position
    local delta   = destPos - curPos
    local distance = delta.Magnitude
    if distance <= ANTIBAN_MAX_STEP then
        myHRP.CFrame = destCF
        return
    end
    local steps = math.ceil(distance / ANTIBAN_MAX_STEP)
    task.spawn(function()
        local startCF = myHRP.CFrame
        for i = 1, steps do
            if not myHRP or not myHRP.Parent then return end
            local alpha = i / steps
            myHRP.CFrame = startCF:Lerp(destCF, alpha)
            task.wait()
        end
    end)
end

function returnFromTP()
    if not TPConfig.SavedPosition then return end
    if not TPConfig.ReturnOnDisengage then
        TPConfig.SavedPosition = nil
        return
    end
    local myHRP = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if myHRP then
        local startCF = myHRP.CFrame
        local endCF   = TPConfig.SavedPosition
        local dist    = (startCF.Position - endCF.Position).Magnitude
        if dist <= ANTIBAN_MAX_STEP then
            myHRP.CFrame = endCF
        else
            task.spawn(function()
                local steps = math.ceil(dist / 15)
                for i = 1, steps do
                    if not myHRP or not myHRP.Parent then return end
                    myHRP.CFrame = startCF:Lerp(endCF, i / steps)
                    task.wait()
                end
            end)
        end
    end
    TPConfig.SavedPosition = nil
end

function findClosestPlayerForTP()
    local myPos = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myPos then return nil end
    local screenCenter = Camera.ViewportSize / 2
    local bestPlayer, bestDist = nil, math.huge
    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local sp = Camera:WorldToViewportPoint(hrp.Position)
                    if sp.Z > 0 then
                        local d2 = (screenCenter.X - sp.X) ^ 2
                                 + (screenCenter.Y - sp.Y) ^ 2
                        if d2 < bestDist then
                            bestPlayer = p
                            bestDist   = d2
                        end
                    end
                end
            end
        end
    end
    return bestPlayer
end

function predictTargetCFrame(targetHRP)
    local pos = targetHRP.Position
    local vel = targetHRP.AssemblyLinearVelocity or Vector3.zero
    local pingComp = TPConfig.PingCompensation
        and (getPingSeconds() * TPConfig.PingCompMultiplier) or 0
    local predictTime = (TPConfig.PredictTarget and TPConfig.PredictionStrength or 0) + pingComp
    pos = pos + vel * predictTime
    local rot = targetHRP.CFrame - targetHRP.CFrame.Position
    return CFrame.new(pos) * rot, vel
end

function getTPOffset(targetHRP)
    if not targetHRP then return CFrame.new() end
    local targetCF, vel = predictTargetCFrame(targetHRP)
    local d = TPConfig.TPDistance
    local hOffset = TPConfig.HeightOffset or 0
    local m = TPConfig.TPMethod
    if TPConfig.StayBehind then
        local behindPos = targetCF.Position
            - targetCF.LookVector * d + Vector3.new(0, hOffset, 0)
        return CFrame.new(behindPos, targetCF.Position)
    end
    if m == "Behind" then
        return targetCF * CFrame.new(0, hOffset, d)
    elseif m == "Front" then
        return targetCF * CFrame.new(0, hOffset, -d)
    elseif m == "Above" then
        return targetCF * CFrame.new(0, d + hOffset, 0)
    elseif m == "Below" then
        return targetCF * CFrame.new(0, -d + hOffset, 0)
    elseif m == "Right" then
        return targetCF * CFrame.new(d, hOffset, 0)
    elseif m == "Left" then
        return targetCF * CFrame.new(-d, hOffset, 0)
    elseif m == "Inside" then
        return CFrame.new(targetCF.Position + Vector3.new(0, hOffset, 0))
    elseif m == "Bag" then
        return targetCF * CFrame.new(0, hOffset, 0.5) * CFrame.Angles(0, math.rad(180), 0)
    elseif m == "Kill" then
        local attach = math.max(TPConfig.KillAttachDistance or 2.5, 1.5)
        local pos = targetCF.Position - targetCF.LookVector * 0.5 + Vector3.new(0, attach, 0)
        return CFrame.new(pos, targetCF.Position)
    elseif m == "Auto" then
        local speed = vel.Magnitude
        if vel.Y > 8 then
            return targetCF * CFrame.new(0, d * 0.5 + hOffset, 0)
        elseif speed > 25 then
            local moveDir = vel.Magnitude > 0 and vel.Unit or targetCF.LookVector
            return CFrame.new(
                targetCF.Position + moveDir * (d * 0.7) + Vector3.new(0, hOffset, 0),
                targetCF.Position
            )
        else
            return targetCF * CFrame.new(0, hOffset, d)
        end
    end
    return targetCF * CFrame.new(0, hOffset, d)
end

local stompWatchers = {}

function setupStompWatcher(target)
    if not target or not target.Character then return end
    if stompWatchers[target] then
        safeDisconnect(stompWatchers[target])
        stompWatchers[target] = nil
    end
    local char = target.Character
    local be   = char:FindFirstChild("BodyEffects")
    if not be then return end
    local ko = be:FindFirstChild("K.O")
    if not ko then return end
    stompWatchers[target] = ko:GetPropertyChangedSignal("Value"):Connect(function()
        if not TPConfig.StompOnKill then return end
        if not (TPConfig.Following or TPConfig.Enabled) then return end
        if ko.Value == true then
            TPConfig.DidStomp = true
            task.spawn(function()
                task.wait(0.05)
                local myChar = LocalPlayer.Character
                local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local tHRP   = char:FindFirstChild("HumanoidRootPart")
                if myHRP and tHRP then
                    local destCF = CFrame.new(tHRP.Position + Vector3.new(0, 2.2, 0))
                    safeTpStep(myHRP, destCF)
                    myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end)
        end
    end)
end

function startTPFollow()
    if tpFollowConnection then tpFollowConnection:Disconnect() end
    TPConfig.Following = true
    TPConfig.DidStomp  = false
    saveTPReturnPosition()
    if Toggles and Toggles.TPOnlyWhenAiming then
        TPConfig.OnlyWhenAiming = Toggles.TPOnlyWhenAiming.Value
    end
    tpFollowConnection = Services.RunService.Heartbeat:Connect(function()
        if not TPConfig.Following then return end
        if not scriptActive then return end
        if TPConfig.CycleTargets then
            local now = tick()
            if now - TPConfig.LastCycleTime > TPConfig.CycleInterval then
                local selected = getSelectedTPPlayers()
                if #selected > 0 then
                    TPConfig.CurrentCycleIndex = (TPConfig.CurrentCycleIndex % #selected) + 1
                    local nxt = selected[TPConfig.CurrentCycleIndex]
                    if nxt and isTPTargetAlive(nxt) then
                        if TPConfig.LockedTarget ~= nxt then
                            TPConfig.LockedTarget = nxt
                            setupStompWatcher(nxt)
                        end
                    end
                end
                TPConfig.LastCycleTime = now
            end
        end
        local target = TPConfig.LockedTarget
        if not target then return end
        if not isTPTargetAlive(target) then
            if TPConfig.AutoSwitchTarget then
                local selected = getSelectedTPPlayers()
                for _, p in ipairs(selected) do
                    if isTPTargetAlive(p) then
                        TPConfig.LockedTarget = p
                        setupStompWatcher(p)
                        return
                    end
                end
                local nxt = findClosestPlayerForTP()
                if nxt then
                    TPConfig.LockedTarget = nxt
                    setupStompWatcher(nxt)
                    return
                end
            end
            TPConfig.LockedTarget = nil
            TPConfig.Following    = false
            if tpFollowConnection then
                tpFollowConnection:Disconnect()
                tpFollowConnection = nil
            end
            if not TPConfig.DidStomp then
                returnFromTP()
            else
                TPConfig.SavedPosition = nil
            end
            TPConfig.DidStomp = false
            return
        end
        if TPConfig.OnlyWhenAiming then
            if not Services.UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                return
            end
        end
        local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
        if not targetHRP then return end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        local targetCF = getTPOffset(targetHRP)
        if TPConfig.SmoothFollow then
            local alpha = math.clamp(TPConfig.SmoothSpeed, 0.01, 1)
            local interp = myHRP.CFrame:Lerp(targetCF, alpha)
            safeTpStep(myHRP, interp)
        else
            safeTpStep(myHRP, targetCF)
        end
        if TPConfig.MatchVelocity then
            local vel = targetHRP.AssemblyLinearVelocity or Vector3.zero
            myHRP.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(vel.Y, 0), vel.Z)
        end
        if TPConfig.TPMethod == "Kill" and TPConfig.KillAutoFire then
            local tool = myChar:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
        elseif TPConfig.AutoFireWhilstTP then
            local tool = myChar:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
        end
    end)
end

function stopTPFollow()
    TPConfig.Following = false
    safeDisconnect(tpFollowConnection)
    tpFollowConnection = nil
    for _, conn in pairs(stompWatchers) do safeDisconnect(conn) end
    stompWatchers = {}
    if not TPConfig.DidStomp then
        returnFromTP()
    else
        TPConfig.SavedPosition = nil
    end
    TPConfig.DidStomp = false
end

function startTPWithSelected()
    local selected = getSelectedTPPlayers()
    if #selected == 0 then
        local target = findClosestPlayerForTP()
        if target then
            TPConfig.LockedTarget = target
            setupStompWatcher(target)
            startTPFollow()
            return true
        end
        return false
    end
    for _, p in ipairs(selected) do
        if isTPTargetAlive(p) then
            TPConfig.LockedTarget      = p
            TPConfig.LastCycleTime     = tick()
            TPConfig.CurrentCycleIndex = 1
            setupStompWatcher(p)
            startTPFollow()
            return true
        end
    end
    return false
end

