------------------------------------------------------------
-- SECTION 10. Multipoint distribution math (FIXED)
-- Точки строго внутри парта, центр строго в (0,0,0),
-- никакого выхода за границы.
------------------------------------------------------------

local MultipointSetCache = {}

function buildExactPointSet(N)
    N = math.clamp(math.floor(N or 1), 1, 20)
    local pts = {}
    -- Центр всегда первый
    pts[1] = Vector3.new(0, 0, 0)
    if N <= 1 then
        return pts
    end

    -- Подбираем сетку (nx, ny, nz) которая даст хотя бы N точек
    local best
    for nx = 1, 4 do
        for ny = 1, 6 do
            for nz = 1, 3 do
                local total = nx * ny * nz
                if total >= N then
                    local extra = total - N
                    local shape = math.abs(ny - math.ceil(nx * 1.3)) + math.abs(nx - nz)
                    local score = extra * 2 + shape
                    if not best or score < best.score then
                        best = { nx = nx, ny = ny, nz = nz, score = score, total = total }
                    end
                end
            end
        end
    end
    if not best then best = { nx = 2, ny = 3, nz = 2, total = 12 } end
    local nx, ny, nz = best.nx, best.ny, best.nz

    -- Margin строго < 0.5 чтобы точки были ВНУТРИ парта (не на грани)
    local margin = 0.40

    -- Корректный frac: для n=1 даёт 0, для n>=2 равномерно в [-margin, +margin]
    local function frac(i, n)
        if n <= 1 then return 0 end
        -- i в диапазоне [0, n-1], результат [-margin, +margin]
        return ((i / (n - 1)) - 0.5) * 2 * margin
    end

    local raw = {}
    for iy = 0, ny - 1 do
        for ix = 0, nx - 1 do
            for iz = 0, nz - 1 do
                local fx = frac(ix, nx)
                local fy = frac(iy, ny)
                -- Z берём меньше, чтобы точки были более "плоско" расположены
                local fz = frac(iz, nz) * 0.6
                -- Не дублируем центр
                if not (math.abs(fx) < 0.001 and math.abs(fy) < 0.001 and math.abs(fz) < 0.001) then
                    raw[#raw + 1] = Vector3.new(fx, fy, fz)
                end
            end
        end
    end

    -- Берём ровно N-1 (центр уже добавлен)
    for i = 1, math.min(N - 1, #raw) do
        pts[#pts + 1] = raw[i]
    end
    return pts
end

function getMultipointSet()
    local n = Config.MultipointCount or 5
    if not MultipointSetCache[n] then
        MultipointSetCache[n] = buildExactPointSet(n)
    end
    return MultipointSetCache[n]
end

-- Если multipoint выключен — возвращаем ОДНУ точку в центре парта
function getBestPointOnPart(part, refPos)
    if not Config.Multipoint then
        local center = part.Position
        local sp = Camera:WorldToViewportPoint(center)
        if sp.Z > 0 then
            local dx, dy = refPos.X - sp.X, refPos.Y - sp.Y
            return center, dx * dx + dy * dy
        end
        return center, math.huge
    end

    local pts = getMultipointSet()
    local sz, cf = part.Size, part.CFrame
    local center = cf.Position
    if #pts <= 1 then
        local sp = Camera:WorldToViewportPoint(center)
        if sp.Z > 0 then
            local dx, dy = refPos.X - sp.X, refPos.Y - sp.Y
            return center, dx * dx + dy * dy
        end
        return center, math.huge
    end
    local bestPt, bestDist = center, math.huge
    for i = 1, #pts do
        local off = pts[i]
        -- off уже нормализован в [-margin, +margin], умножаем на размер парта
        local wp = (cf * CFrame.new(sz.X * off.X, sz.Y * off.Y, sz.Z * off.Z)).Position
        local sp = Camera:WorldToViewportPoint(wp)
        if sp.Z > 0 then
            local dx, dy = refPos.X - sp.X, refPos.Y - sp.Y
            local d = dx * dx + dy * dy
            if d < bestDist then
                bestDist = d
                bestPt   = wp
            end
        end
    end
    return bestPt, bestDist
end

