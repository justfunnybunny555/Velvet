local OriginalFog = {
    FogStart = Services.Lighting.FogStart,
    FogEnd   = Services.Lighting.FogEnd,
    FogColor = Services.Lighting.FogColor,
}

function updateFog()
    if not scriptActive then return end
    if Config.Fog.Enabled then
        Services.Lighting.FogStart = Config.Fog.FogStart
        Services.Lighting.FogEnd   = Config.Fog.FogEnd
        if Config.Fog.GlowEnabled then
            local intensity  = math.clamp(Config.Fog.GlowBrightness / 3, 0, 1)
            local sizeFactor = math.clamp(Config.Fog.GlowSize / 56, 0, 1)
            local blend      = math.clamp(intensity * (0.4 + sizeFactor * 0.6), 0, 1)
            local fr, fg, fb = Config.Fog.FogColor.R, Config.Fog.FogColor.G, Config.Fog.FogColor.B
            local gr, gg, gb = Config.Fog.GlowColor.R, Config.Fog.GlowColor.G, Config.Fog.GlowColor.B
            Services.Lighting.FogColor = Color3.new(
                math.clamp(fr + (gr - fr) * blend, 0, 1),
                math.clamp(fg + (gg - fg) * blend, 0, 1),
                math.clamp(fb + (gb - fb) * blend, 0, 1)
            )
        else
            Services.Lighting.FogColor = Config.Fog.FogColor
        end
    else
        Services.Lighting.FogStart = OriginalFog.FogStart
        Services.Lighting.FogEnd   = OriginalFog.FogEnd
        Services.Lighting.FogColor = OriginalFog.FogColor
    end
end

function restoreFogToOriginal()
    pcall(function()
        Services.Lighting.FogStart = OriginalFog.FogStart
        Services.Lighting.FogEnd   = OriginalFog.FogEnd
        Services.Lighting.FogColor = OriginalFog.FogColor
    end)
end

