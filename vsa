------------------------------------------------------------
-- SECTION 15. Closest point / closest part helpers (FIXED)
-- Главное исправление: убираем смещение по Y вниз.
-- Если multipoint выключен — целимся СТРОГО в центр парта.
-- Если включен — берём ближайшую точку из multipoint set,
-- которая находится ВНУТРИ парта.
------------------------------------------------------------

function getClosestPointOnPart(part, refPos)
    -- ВАЖНО: если multipoint выключен — возвращаем СТРОГО центр парта.
    -- Это исправляет проблему "смещения вниз".
    if not Config.Multipoint then
        return part.Position
    end

    -- Если включен — используем мультипоинт логику
    local pt, _ = getBestPointOnPart(part, refPos)
    return pt
end

function getClosestPartMulti(character, refPos)
    if not character then return nil, nil end
    if not hasAnyHitPart() then return nil, nil end
    local candidates, cc = {}, 0
    for partName in pairs(Config.HitParts) do
        local p = character:FindFirstChild(partName)
        if p and p:IsA("BasePart") then
            local sp = Camera:WorldToViewportPoint(p.Position)
            if sp.Z > 0 then
                cc = cc + 1
                candidates[cc] = {
                    part = p,
                    dist = (refPos.X - sp.X) ^ 2 + (refPos.Y - sp.Y) ^ 2,
                }
            end
        end
    end
    if cc == 0 then return nil, nil end
    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    local topN = math.min(cc, 3)
    local bestP, bestPt, bestDist = nil, nil, math.huge
    for i = 1, topN do
        local p = candidates[i].part
        if Config.Multipoint then
            local pt, d = getBestPointOnPart(p, refPos)
            if d < bestDist then
                bestP    = p
                bestPt   = pt
                bestDist = d
            end
        else
            -- Multipoint выключен — целимся СТРОГО в центр парта
            local pt = p.Position
            local sp = Camera:WorldToViewportPoint(pt)
            if sp.Z > 0 then
                local d = (refPos.X - sp.X) ^ 2 + (refPos.Y - sp.Y) ^ 2
                if d < bestDist then
                    bestP    = p
                    bestPt   = pt
                    bestDist = d
                end
            end
        end
    end
    return bestP, bestPt
end

function getClosestPartMultiToggle(character, refPos)
    if not character then return nil, nil end
    if not hasAnyHitPart() then return nil, nil end
    local p, pt = getClosestPartMulti(character, refPos)
    if p and pt then return p, pt end
    for partName in pairs(Config.HitParts) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            return part, part.Position
        end
    end
    return nil, nil
end

function getClosestPartMultiML(character, refPos)
    if not character then return nil end
    if not hasAnyHitPartML() then
        return character:FindFirstChild("HumanoidRootPart")
    end
    local bestPart, bestDist = nil, math.huge
    for partName in pairs(Config.MouseLock.HitParts) do
        local p = character:FindFirstChild(partName)
        if p and p:IsA("BasePart") then
            local sp = Camera:WorldToViewportPoint(p.Position)
            if sp.Z > 0 then
                local d = (refPos.X - sp.X) ^ 2 + (refPos.Y - sp.Y) ^ 2
                if d < bestDist then
                    bestPart = p
                    bestDist = d
                end
            end
        end
    end
    return bestPart
end

function canTargetPlayer(player)
    if not player or player == LocalPlayer then return false end
    if not player.Character then return false end
    if isWhitelisted(player) then return false end
