local triggerbotCooldown    = 0
local triggerbotBurstActive = false
local triggerbotKeyHeld     = false

function findTriggerbotTarget()
    local myPos = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myPos then return nil end
    local tbFovOrigin = getFOVOrigin(Config.Triggerbot.FOVMode)
    local bestPlayer, bestDist = nil, math.huge
    local checkParts = { "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart" }
    for _, p in ipairs(Services.Players:GetPlayers()) do
        if canTargetPlayerTB(p) then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (myPos.Position - hrp.Position).Magnitude
                if dist <= Config.Triggerbot.MaxDistance then
                    if Config.Triggerbot.FOVMethod == "New FOV" then
                        if isMouseIn3DBox(p, tbFovOrigin,
                            Config.Triggerbot.FOVX,
                            Config.Triggerbot.FOVY,
                            Config.Triggerbot.FOVZ) then
                            if not hasWallBetweenTB(Camera.CFrame.Position, hrp) then
                                if dist < bestDist then
                                    bestPlayer = p
                                    bestDist   = dist
                                end
                            end
                        end
                    else
                        local fovSq = Config.Triggerbot.FOVSize * Config.Triggerbot.FOVSize
                        for _, partName in ipairs(checkParts) do
                            local tp = p.Character:FindFirstChild(partName)
                            if tp then
                                local sp = Camera:WorldToViewportPoint(tp.Position)
                                if sp.Z > 0 then
                                    local d2 = (tbFovOrigin.X - sp.X) ^ 2
                                             + (tbFovOrigin.Y - sp.Y) ^ 2
                                    if d2 <= fovSq
                                        and not hasWallBetweenTB(Camera.CFrame.Position, tp) then
                                        if d2 < bestDist then
                                            bestPlayer = p
                                            bestDist   = d2
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPlayer
end

function updateTriggerbot()
    if not scriptActive then return end
    if not Config.Triggerbot.Enabled or triggerbotBurstActive then return end
    local isActive = Config.Triggerbot.Mode == "Hold"
        and triggerbotKeyHeld
        or Config.Triggerbot.Active
    if not isActive then return end
    local now = tick()
    if now - triggerbotCooldown < Config.Triggerbot.Delay then return end
    local target = findTriggerbotTarget()
    if not target then return end
    local tool = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool then return end
    triggerbotCooldown = now
    if Config.Triggerbot.BurstMode then
        triggerbotBurstActive = true
        task.spawn(function()
            for i = 1, Config.Triggerbot.BurstCount do
                if not Config.Triggerbot.Enabled or not scriptActive then break end
                tool:Activate()
                if i < Config.Triggerbot.BurstCount then
                    task.wait(Config.Triggerbot.BurstDelay)
                end
            end
            triggerbotBurstActive = false
        end)
    else
        tool:Activate()
    end
end

