function getPredictedPosition(targetPart, targetPoint)
    local pos = targetPoint
    if Config.Prediction and targetPart then
        local vel = targetPart.AssemblyLinearVelocity or Vector3.zero
        local predAmount = Config.PredictionAmount
        if predAmount > 0 then
            pos = pos + vel * predAmount
        end
    end
    if Config.JumpOffsetEnabled and targetPart and Config.JumpOffset ~= 0 then
        local vel = targetPart.AssemblyLinearVelocity or Vector3.zero
        if math.abs(vel.Y) > 2 then
            pos = pos + Vector3.new(0, vel.Y * Config.JumpOffset, 0)
        end
    end
    return pos
end

