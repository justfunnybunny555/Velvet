HookState.oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    if KILL_FLAG then
        if HookState.oldNamecall then return HookState.oldNamecall(...) end
        return
    end
    if not scriptActive then return HookState.oldNamecall(...) end
    local method = getnamecallmethod()

    if Config.Enabled and cachedTarget and cachedTargetPoint
        and not checkcaller() then

        if method == "ScreenPointToRay" or method == "ViewportPointToRay" then
            if Config.HitChance < 100 and not rollHitChance() then
                return HookState.oldNamecall(...)
            end

            if Config.Method == "New" then
                local predPos = getPredictedPosition(cachedTarget, cachedTargetPoint)
                local originalRay = HookState.oldNamecall(...)
                if originalRay then
                    local dir = (predPos - originalRay.Origin)
                    if dir.Magnitude > 0 then
                        return Ray.new(originalRay.Origin, dir.Unit)
                    end
                end
                return originalRay
            end
        end

        if method == "FireServer" or method == "InvokeServer" then
        end
    end

    return HookState.oldNamecall(...)
end))

HookState.oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, prop)
    if KILL_FLAG then
        if HookState.oldIndex then return HookState.oldIndex(self, prop) end
        return
    end
    if not scriptActive then return HookState.oldIndex(self, prop) end

    if Config.Enabled and Config.Method == "Old"
        and cachedTarget and cachedTargetPoint and not checkcaller() then
        if self:IsA("Mouse") then
            if prop == "Target" or prop == "target" then
                return cachedTarget
            elseif prop == "Hit" or prop == "hit" then
                local predPos = getPredictedPosition(cachedTarget, cachedTargetPoint)
                return CFrame.new(predPos,
                    predPos + Camera.CFrame.LookVector)
            end
        end
    end

    return HookState.oldIndex(self, prop)
end))

HookState.oldRandom = hookfunction(math.random, function(...)
