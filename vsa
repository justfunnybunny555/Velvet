local noclipConnection, noclipKeyHeld, wasNoclipping = nil, false, false

function restoreCollisions(char)
    if not char then return end
    for _, n in ipairs({ "HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso" }) do
        local part = char:FindFirstChild(n)
        if part and part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

function ensureNoclipConnection()
    if noclipConnection then return end
    noclipConnection = Services.RunService.Stepped:Connect(function()
        if not scriptActive then return end
        local char = LocalPlayer.Character
        if not char then return end
        if MovementConfig.Noclip and MovementConfig.NoclipActive then
            wasNoclipping = true
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        elseif wasNoclipping then
            wasNoclipping = false
            restoreCollisions(char)
        end
    end)
end

function destroyNoclipConnection()
    safeDisconnect(noclipConnection)
    noclipConnection = nil
    if wasNoclipping then
        wasNoclipping = false
        restoreCollisions(LocalPlayer.Character)
    end
end

