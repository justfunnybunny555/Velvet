    if not Config.KnockedCheck then return false end
    return isKnockedRaw(player)
end
function isKnockedML(player)
    if not Config.MouseLock.KOCheck then return false end
    return isKnockedRaw(player)
end
function isKnockedTB(player)
    if not Config.Triggerbot.KOCheck then return false end
    return isKnockedRaw(player)
end

function isPlayerDead(player)
    local char = player.Character
    if not char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return not hum or hum.Health <= 0
end

function isPlayerInvincible(character)
    if not character then return false end
    if character:FindFirstChildOfClass("ForceField") then return true end
    local be = character:FindFirstChild("BodyEffects")
    if be then
        for _, name in ipairs({ "Invincible", "Shield", "GodMode", "Bubble" }) do
            local val = be:FindFirstChild(name)
            if val and val.Value then return true end
        end
    end
    return false
end

