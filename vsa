function getFOVOrigin(mode)
    if mode == "Center" then
        return Camera.ViewportSize / 2
    else
        return Services.UserInputService:GetMouseLocation()
    end
end

function cross2D(ox, oy, ax, ay, bx, by)
    return (ax - ox) * (by - oy) - (ay - oy) * (bx - ox)
end

function convexHull2D(points)
    if #points < 3 then return points end
    local startIdx = 1
    for i = 2, #points do
        if points[i].Y > points[startIdx].Y or
           (points[i].Y == points[startIdx].Y and points[i].X < points[startIdx].X) then
            startIdx = i
        end
    end
    points[1], points[startIdx] = points[startIdx], points[1]
    local pivot = points[1]
    table.sort(points, function(a, b)
        if a == pivot then return true end
        if b == pivot then return false end
        local c = cross2D(pivot.X, pivot.Y, a.X, a.Y, b.X, b.Y)
        if math.abs(c) < 1e-9 then
            return ((a.X - pivot.X) ^ 2 + (a.Y - pivot.Y) ^ 2)
                 < ((b.X - pivot.X) ^ 2 + (b.Y - pivot.Y) ^ 2)
        end
        return c > 0
    end)
    local hull = { points[1], points[2] }
    for i = 3, #points do
        while #hull >= 2 do
            local top = hull[#hull]
            local sec = hull[#hull - 1]
            if cross2D(sec.X, sec.Y, top.X, top.Y, points[i].X, points[i].Y) <= 0 then
                hull[#hull] = nil
            else
                break
            end
        end
        hull[#hull + 1] = points[i]
    end
    return hull
end

function pointInConvexHull(px, py, hull)
    local n = #hull
    if n < 3 then return false end
    for i = 1, n do
        local j = (i % n) + 1
        if cross2D(hull[i].X, hull[i].Y, hull[j].X, hull[j].Y, px, py) < 0 then
            return false
        end
    end
    return true
end

function isMouseIn3DBox(player, mousePos, fx, fy, fz)
    if not player or not player.Character then return false end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local cf = hrp.CFrame
    local hx, hy, hz = fx / 2, fy / 2, fz / 2
    local corners = {
        cf * Vector3.new(-hx, -hy, -hz),
        cf * Vector3.new( hx, -hy, -hz),
        cf * Vector3.new(-hx,  hy, -hz),
        cf * Vector3.new( hx,  hy, -hz),
        cf * Vector3.new(-hx, -hy,  hz),
        cf * Vector3.new( hx, -hy,  hz),
        cf * Vector3.new(-hx,  hy,  hz),
        cf * Vector3.new( hx,  hy,  hz),
    }
    local screenPoints = {}
    for i = 1, 8 do
        local sp = Camera:WorldToViewportPoint(corners[i])
        if sp.Z > 0 then
            screenPoints[#screenPoints + 1] = { X = sp.X, Y = sp.Y }
        end
    end
    if #screenPoints < 3 then return false end
    local hull = convexHull2D(screenPoints)
    if #hull < 3 then return false end
    return pointInConvexHull(mousePos.X, mousePos.Y, hull)
end

