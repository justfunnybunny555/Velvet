local mouseLockKeyHeld = false

function findClosestPlayerForMouseLock()
    local myPos = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myPos then return nil end
    local screenCenter = getFOVOrigin(Config.MouseLock.FOVMode)
    local fovSq = Config.MouseLock.FOVSize * Config.MouseLock.FOVSize
    local bestPlayer, bestDist = nil, math.huge
    for _, p in ipairs(Services.Players:GetPlayers()) do
        if canTargetPlayerML(p) then
            local targetPart = getClosestPartMultiML(p.Character, screenCenter)
                or p.Character:FindFirstChild("HumanoidRootPart")
            if targetPart then
                local dist = (myPos.Position - targetPart.Position).Magnitude
                if dist <= Config.MouseLock.MaxDistance then
                    local sp = Camera:WorldToViewportPoint(targetPart.Position)
                    if sp.Z > 0 then
                        local d2 = (screenCenter.X - sp.X) ^ 2 + (screenCenter.Y - sp.Y) ^ 2
                        if d2 <= fovSq
                            and not hasWallBetweenML(Camera.CFrame.Position, targetPart) then
                            if d2 < bestDist then
                                bestPlayer = p
                                bestDist   = d2
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPlayer
end

function updateMouseLock()
    if not scriptActive then return end
    if not Config.MouseLock.Enabled then
        Config.MouseLock.LockedTarget = nil
        Config.MouseLock.Active       = false
        return
    end
    local isActive = Config.MouseLock.Mode == "Hold"
        and mouseLockKeyHeld
        or Config.MouseLock.Active
    if not isActive then
        if not Config.MouseLock.Sticky then
            Config.MouseLock.LockedTarget = nil
        end
        return
    end
    local target = Config.MouseLock.LockedTarget
    if target then
        if isWhitelisted(target) then
            Config.MouseLock.LockedTarget = nil
            return
        end
        if not target.Parent or not target.Character then
            Config.MouseLock.LockedTarget = nil
            if Config.MouseLockNotifications and Library then
                Library:Notify("MouseLock: Target lost", 2)
            end
            return
        end
        if isPlayerDead(target) or isKnockedRaw(target) then
            Config.MouseLock.LockedTarget = nil
            if Config.MouseLock.Mode == "Toggle" then
                Config.MouseLock.Active = false
            end
            if Config.MouseLockNotifications and Library then
                Library:Notify("MouseLock: " .. target.Name .. " KO'd", 2)
            end
            return
        end
        if Config.MouseLock.TeamCheck and isSameTeamDaHood(LocalPlayer, target) then
            Config.MouseLock.LockedTarget = nil
            return
        end
        if Config.MouseLock.WallCheck then
            local sc = getFOVOrigin(Config.MouseLock.FOVMode)
            local tp = getClosestPartMultiML(target.Character, sc)
                or target.Character:FindFirstChild("HumanoidRootPart")
            if tp and hasWallBetweenMLRaw(Camera.CFrame.Position, tp) then
                if not Config.MouseLock.Sticky then
                    Config.MouseLock.LockedTarget = nil
                    if Config.MouseLock.Mode == "Toggle" then
                        Config.MouseLock.Active = false
                    end
                    if Config.MouseLockNotifications and Library then
                        Library:Notify("MouseLock: Wall block", 2)
                    end
                end
                return
            end
        end
        local myHRP = LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local tHRP  = target.Character:FindFirstChild("HumanoidRootPart")
        if myHRP and tHRP
            and (myHRP.Position - tHRP.Position).Magnitude > Config.MouseLock.MaxDistance then
            if not Config.MouseLock.Sticky then
                Config.MouseLock.LockedTarget = nil
                if Config.MouseLock.Mode == "Toggle" then
                    Config.MouseLock.Active = false
                end
                if Config.MouseLockNotifications and Library then
                    Library:Notify("MouseLock: Too far", 2)
                end
            end
            return
        end
    end
    if not target then return end
    local sc = getFOVOrigin(Config.MouseLock.FOVMode)
    local targetPart = getClosestPartMultiML(target.Character, sc)
        or target.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end
    local targetPos = targetPart.Position
    if Config.MouseLock.Prediction then
        local vel = targetPart.AssemblyLinearVelocity or Vector3.zero
        local predAmt = Config.MouseLock.PredictionAmount
        if Config.AutoPrediction then
            predAmt = predAmt + (getPingSeconds() * 0)
        end
        targetPos = targetPos + vel * predAmt
    end
    local screenPos = Camera:WorldToViewportPoint(targetPos)
    if screenPos.Z <= 0 then return end
    local sfx = math.clamp(Config.MouseLock.SmoothX / 10, 0.1, 1)
    local sfy = math.clamp(Config.MouseLock.SmoothY / 10, 0.1, 1)
    if Config.MouseLock.LockType == "CamLock" then
        local camCenter = Camera.ViewportSize / 2
        local mx = (screenPos.X - camCenter.X) * sfx * Config.MouseLock.Sensitivity
        local my = (screenPos.Y - camCenter.Y) * sfy * Config.MouseLock.Sensitivity
        if math.abs(mx) > 0.05 or math.abs(my) > 0.05 then
            mousemoverel(mx, my)
        end
    else
        local cur = Services.UserInputService:GetMouseLocation()
        local mx = (screenPos.X - cur.X) * sfx * Config.MouseLock.Sensitivity
        local my = (screenPos.Y - cur.Y) * sfy * Config.MouseLock.Sensitivity
        if math.abs(mx) > 0.05 or math.abs(my) > 0.05 then
            mousemoverel(mx, my)
        end
    end
end

