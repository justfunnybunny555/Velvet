function isSameTeamDaHood(playerA, playerB)
    if not playerA or not playerB then return false end
    if playerA == playerB then return true end
    if playerA.Team and playerB.Team and playerA.Team == playerB.Team then return true end
    local sA = playerA:FindFirstChild("leaderstats")
    local sB = playerB:FindFirstChild("leaderstats")
    if sA and sB then
        for _, n in ipairs({ "Crew", "Gang", "Team", "Clan", "Group" }) do
            local vA = sA:FindFirstChild(n)
            local vB = sB:FindFirstChild(n)
            if vA and vB and tostring(vA.Value) ~= ""
                and tostring(vA.Value) == tostring(vB.Value) then
                return true
            end
        end
    end
    return false
end

function isOnSameTeam(player)
    if not Config.TeamCheck then return false end
    return isSameTeamDaHood(LocalPlayer, player)
end
function isOnSameTeamML(player)
    if not Config.MouseLock.TeamCheck then return false end
    return isSameTeamDaHood(LocalPlayer, player)
end
function isOnSameTeamTB(player)
    if not Config.Triggerbot.TeamCheck then return false end
    return isSameTeamDaHood(LocalPlayer, player)
