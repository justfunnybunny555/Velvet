local HitboxConnections, HitboxActive = {}, false
local HitboxOriginalSizes        = {}
local HitboxOriginalTransparency = {}
local HitboxOriginalDecals       = {}
local HitboxOriginalCanCollide   = {}
local HitboxOriginalMassless     = {}

function getOriginalSize(part)
    if HitboxOriginalSizes[part] then
        return HitboxOriginalSizes[part]
    end
    HitboxOriginalSizes[part] = part.Size
    return HitboxOriginalSizes[part]
end

function applyOvalMesh(part, scale)
    local mesh = part:FindFirstChild("VELVET_OvalMesh")
    if not mesh then
        mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.Sphere
        mesh.Name     = "VELVET_OvalMesh"
        mesh.Parent   = part
    end
    if mesh.Scale ~= scale then
        mesh.Scale = scale
    end
end

function removeOvalMesh(part)
    if not part then return end
    local mesh = part:FindFirstChild("VELVET_OvalMesh")
    if mesh then mesh:Destroy() end
end

function setDecalsTransparency(part, value)
    if not part then return end
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("Decal") then
            if HitboxOriginalDecals[child] == nil then
                HitboxOriginalDecals[child] = child.Transparency
            end
            if child.Transparency ~= value then
                child.Transparency = value
            end
        end
    end
end

function restoreDecals(part)
    if not part then return end
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("Decal") and HitboxOriginalDecals[child] ~= nil then
            child.Transparency = HitboxOriginalDecals[child]
        end
    end
end

function restoreHitboxPart(part)
    if not part or not part:IsA("BasePart") then return end
    local orig = HitboxOriginalSizes[part]
    if orig then
        pcall(function() part.Size = orig end)
    end
    removeOvalMesh(part)
    if HitboxOriginalTransparency[part] ~= nil then
        pcall(function() part.Transparency = HitboxOriginalTransparency[part] end)
    end
    if HitboxOriginalCanCollide[part] ~= nil then
        pcall(function() part.CanCollide = HitboxOriginalCanCollide[part] end)
    else
        pcall(function() part.CanCollide = true end)
    end
    if HitboxOriginalMassless[part] ~= nil then
        pcall(function() part.Massless = HitboxOriginalMassless[part] end)
    else
        pcall(function() part.Massless = false end)
    end
    restoreDecals(part)
end

function applyHeadHitbox(headPart, isHit, isKO, isLegit)
    if not headPart or not headPart:IsA("BasePart") then return end
    getOriginalSize(headPart)
    if HitboxOriginalTransparency[headPart] == nil then
        HitboxOriginalTransparency[headPart] = headPart.Transparency
    end
    if HitboxOriginalCanCollide[headPart] == nil then
        HitboxOriginalCanCollide[headPart] = headPart.CanCollide
    end
    if HitboxOriginalMassless[headPart] == nil then
        HitboxOriginalMassless[headPart] = headPart.Massless
    end
    if isKO then
        pcall(function() headPart.Size = HitboxOriginalSizes[headPart] or headPart.Size end)
        removeOvalMesh(headPart)
        if HitboxOriginalTransparency[headPart] ~= nil then
            pcall(function() headPart.Transparency = HitboxOriginalTransparency[headPart] end)
        end
        if HitboxOriginalCanCollide[headPart] ~= nil then
            pcall(function() headPart.CanCollide = HitboxOriginalCanCollide[headPart] end)
        end
        if HitboxOriginalMassless[headPart] ~= nil then
            pcall(function() headPart.Massless = HitboxOriginalMassless[headPart] end)
        end
        restoreDecals(headPart)
        return
    end
    local sx, sy, sz
    if isLegit then
        sx, sy, sz = Config.Hitbox.LegitHeadSizeX,
                     Config.Hitbox.LegitHeadSizeY,
                     Config.Hitbox.LegitHeadSizeZ
        if isHit then sx, sy, sz = 1, 1, 1 end
    else
        sx, sy, sz = Config.Hitbox.HeadSizeX,
                     Config.Hitbox.HeadSizeY,
                     Config.Hitbox.HeadSizeZ
        if isHit then sx, sy, sz = 1, 1, 1 end
    end
    pcall(function() headPart.Size = Vector3.new(sx, sy, sz) end)
    pcall(function() headPart.Transparency = Config.Hitbox.HeadTransparency end)
    pcall(function() headPart.CanCollide = true end)
    pcall(function() headPart.Massless = false end)
    if Config.Hitbox.HeadFadeDecals then
        setDecalsTransparency(headPart, 1)
    else
        restoreDecals(headPart)
    end
end

function applyBodyHitbox(part, isHit, isKO)
    if not part or not part:IsA("BasePart") then return end
    getOriginalSize(part)
    if HitboxOriginalCanCollide[part] == nil then
        HitboxOriginalCanCollide[part] = part.CanCollide
    end
    local normalSize = Vector3.new(Config.Hitbox.SizeX, Config.Hitbox.SizeY, Config.Hitbox.SizeZ)
    if isKO then
        pcall(function() part.Size = Vector3.new(1, 1, 1) end)
        applyOvalMesh(part, Vector3.new(1, 1, 1))
    elseif Config.Hitbox.LegitHitbox then
        local ls = Config.Hitbox.LegitSize
        if isHit then
            pcall(function() part.Size = Vector3.new(ls, ls, ls) end)
        else
            pcall(function() part.Size = normalSize end)
        end
        applyOvalMesh(part, Vector3.new(1.3, 1, 0.8))
    else
        pcall(function() part.Size = normalSize end)
        applyOvalMesh(part, Vector3.new(1.3, 1, 0.8))
    end
    pcall(function() part.CanCollide = false end)
end

function getHeadModeForCharacter(character)
    local useHead    = Config.Hitbox.TargetParts.Head      == true
    local useLegitHd = Config.Hitbox.TargetParts.LegitHead == true
    if useHead    then return "full"  end
    if useLegitHd then return "legit" end
    return nil
end

function updateHitbox(character, isHit, isKO)
    if not Config.Hitbox.Enabled or not character then return end
    local player = Services.Players:GetPlayerFromCharacter(character)
    local skip = (player and (isWhitelisted(player) or isOnSameTeamHitbox(player)))
        or isPlayerInvincible(character)
    if skip then
        for partName in pairs(Config.Hitbox.TargetParts) do
            local realName = partName == "LegitHead" and "Head" or partName
            local part = character:FindFirstChild(realName)
            if part then restoreHitboxPart(part) end
        end
        return
    end
    for partName, enabled in pairs(Config.Hitbox.TargetParts) do
        if partName ~= "Head" and partName ~= "LegitHead" then
            local part = character:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                if enabled then
                    applyBodyHitbox(part, isHit, isKO)
                else
                    restoreHitboxPart(part)
                end
            end
        end
    end
    local headMode = getHeadModeForCharacter(character)
    local headPart = character:FindFirstChild("Head")
    if headPart then
        if headMode == "full" then
            applyHeadHitbox(headPart, isHit, isKO, false)
        elseif headMode == "legit" then
            applyHeadHitbox(headPart, isHit, isKO, true)
        else
            restoreHitboxPart(headPart)
        end
    end
end

function restoreAllHitboxOnChar(character)
    if not character then return end
    for _, partName in ipairs(hitboxPartChoices) do
        local realName = partName == "LegitHead" and "Head" or partName
        local p = character:FindFirstChild(realName)
        if p then restoreHitboxPart(p) end
    end
end

function applyHitboxToCharacter(character)
    if not character or character.Parent == nil or character == LocalPlayer.Character then return end
    if not Config.Hitbox.Enabled then return end
    local player = Services.Players:GetPlayerFromCharacter(character)
    if player and isWhitelisted(player) then return end
    if player and isOnSameTeamHitbox(player) then return end
    local humanoid = character:WaitForChild("Humanoid", 5)
    local hrp      = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not hrp then return end
    local bodyEffects = character:WaitForChild("BodyEffects", 5)
    if not bodyEffects then return end
    local ko = bodyEffects:WaitForChild("K.O", 5)
    if not ko then return end
    local conns = {}
    local isKO, lastHealth, isHit, lastUpdate = ko.Value, humanoid.Health, false, tick()
    if not isPlayerInvincible(character) then
        updateHitbox(character, isHit, isKO)
    end
    conns.maintain = Services.RunService.Heartbeat:Connect(function()
        if not Config.Hitbox.Enabled then
            for _, c in pairs(conns) do safeDisconnect(c) end
            restoreAllHitboxOnChar(character)
            return
        end
        if character and character.Parent and tick() - lastUpdate >= 0 then
            local p = Services.Players:GetPlayerFromCharacter(character)
            local skip = (p and (isWhitelisted(p) or isOnSameTeamHitbox(p)))
                or isPlayerInvincible(character)
            if skip then
                restoreAllHitboxOnChar(character)
            else
                updateHitbox(character, isHit, isKO)
            end
            lastUpdate = tick()
        elseif not character.Parent then
            for _, c in pairs(conns) do safeDisconnect(c) end
        end
    end)
    conns.health = humanoid.HealthChanged:Connect(function(newHealth)
        if not Config.Hitbox.Enabled or isKO then return end
        if newHealth < lastHealth and newHealth > 0 then
            isHit = true
            local p = Services.Players:GetPlayerFromCharacter(character)
            local skip = (p and (isWhitelisted(p) or isOnSameTeamHitbox(p)))
                or isPlayerInvincible(character)
            if not skip then
                updateHitbox(character, isHit, isKO)
            end
            task.spawn(function()
                task.wait(Config.Hitbox.HeadResetDelay or 0.09)
                if character and character.Parent and character:FindFirstChild("HumanoidRootPart") then
                    isHit = false
                    updateHitbox(character, isHit, isKO)
                end
            end)
        end
        lastHealth = newHealth
    end)
    conns.ko = ko:GetPropertyChangedSignal("Value"):Connect(function()
        isKO  = ko.Value
        isHit = false
        if isKO then
            restoreAllHitboxOnChar(character)
        else
            updateHitbox(character, isHit, isKO)
        end
    end)
    conns.death = humanoid.Died:Connect(function()
        restoreAllHitboxOnChar(character)
        for _, c in pairs(conns) do safeDisconnect(c) end
    end)
    conns.ancestry = character.AncestryChanged:Connect(function(_, parent)
        if not parent then
            for _, c in pairs(conns) do safeDisconnect(c) end
        end
    end)
    table.insert(HitboxConnections, conns)
end

function startHitboxSystem()
    if HitboxActive then return end
    HitboxActive = true
    for _, player in ipairs(Services.Players:GetPlayers()) do
        if player ~= LocalPlayer then
            task.spawn(function()
                if player.Character then
                    task.wait(0.1)
                    applyHitboxToCharacter(player.Character)
                end
            end)
            local c = player.CharacterAdded:Connect(function(char)
                task.spawn(function()
                    task.wait(0.5)
                    applyHitboxToCharacter(char)
                end)
            end)
            table.insert(HitboxConnections, { charAdded = c })
        end
    end
    local c2 = Services.Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(function(char)
                task.spawn(function()
                    task.wait(0.5)
                    applyHitboxToCharacter(char)
                end)
            end)
        end
    end)
    table.insert(HitboxConnections, { playerAdded = c2 })
end

function stopHitboxSystem()
    HitboxActive = false
    for _, conns in ipairs(HitboxConnections) do
        if type(conns) == "table" then
            for _, conn in pairs(conns) do safeDisconnect(conn) end
        end
    end
    HitboxConnections = {}
    for _, player in ipairs(Services.Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            restoreAllHitboxOnChar(player.Character)
        end
    end
end

