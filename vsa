function doLocationTP(targetCFOrPos)
    local char = LocalPlayer.Character
    if not char then
        if Library then Library:Notify("TP: Character not found", 2) end
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local destCF
    if typeof(targetCFOrPos) == "CFrame" then
        destCF = targetCFOrPos
    elseif typeof(targetCFOrPos) == "Vector3" then
        local pos = targetCFOrPos
        if DHTPConfig.SafeMode then pos = pos + Vector3.new(0, 4, 0) end
        destCF = CFrame.new(pos)
    elseif type(targetCFOrPos) == "table" then
        if typeof(targetCFOrPos.cf) == "CFrame" then
            destCF = targetCFOrPos.cf
        elseif typeof(targetCFOrPos.pos) == "Vector3" then
            local pos = targetCFOrPos.pos
            if DHTPConfig.SafeMode then pos = pos + Vector3.new(0, 4, 0) end
            destCF = CFrame.new(pos)
        else
            if Library then Library:Notify("TP: Bad table input", 2) end
            return
        end
    else
        if Library then Library:Notify("TP: Bad input type", 2) end
        return
    end

    if DHTPConfig.SafeMode then
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { char }
        rp.IgnoreWater = true
        local lifted = destCF + Vector3.new(0, 50, 0)
        local hit = workspace:Raycast(lifted.Position, Vector3.new(0, -300, 0), rp)
        if hit then
            destCF = CFrame.new(hit.Position + Vector3.new(0, 3, 0))
                * (destCF - destCF.Position)
        end
    end

    hrp.CFrame = destCF
    hrp.AssemblyLinearVelocity = Vector3.zero
end

