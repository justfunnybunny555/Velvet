function update3DFOVVisuals()
    if not scriptActive then return end

    if not Config.Show3DFOV or Config.FOVMethod ~= "New FOV" then
        for _, box in pairs(FOV3DHighlights) do
            pcall(function() box.Visible = false end)
        end
    else
        local boxSize = Vector3.new(Config.FOVX, Config.FOVY, Config.FOVZ)
        for _, player in ipairs(Services.Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not FOV3DHighlights[player] then
                        FOV3DHighlights[player] = create3DBox(
                            Config.FOV3DColor, Config.FOV3DTransparency
                        )
                    end
                    local box = FOV3DHighlights[player]
                    box.Adornee      = hrp
                    box.Size         = boxSize
                    box.CFrame       = CFrame.new()
                    box.Color3       = Config.FOV3DColor
                    box.Transparency = Config.FOV3DTransparency
                    box.Visible      = true
