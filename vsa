function findClosestPlayerInFOV()
    local myPos = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myPos then return nil end
    local fovOrigin = getFOVOrigin(Config.FOVMode)
    local bestPlayer, bestDist = nil, math.huge
    local players = Services.Players:GetPlayers()
    if Config.FOVMethod == "New FOV" then
        for _, p in ipairs(players) do
            if canTargetPlayer(p) then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (myPos.Position - hrp.Position).Magnitude
                    if dist <= Config.MaxDistance
                        and isMouseIn3DBox(p, fovOrigin, Config.FOVX, Config.FOVY, Config.FOVZ) then
                        local part, hitPoint = getClosestPartMulti(p.Character, fovOrigin)
                        if part and hitPoint and not hasWallBetween(Camera.CFrame.Position, part) then
                            if dist < bestDist then
                                bestPlayer = p
                                bestDist   = dist
                            end
                        end
                    end
                end
            end
        end
    else
        local currentFov = getCurrentFOV()
        local fovSq      = currentFov * currentFov
        for _, p in ipairs(players) do
            if canTargetPlayer(p) then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (myPos.Position - hrp.Position).Magnitude
                    if dist <= Config.MaxDistance then
                        local sp = Camera:WorldToViewportPoint(hrp.Position)
                        if sp.Z > 0 then
                            local part, hitPoint = getClosestPartMulti(p.Character, fovOrigin)
                            if part and hitPoint then
                                local sp2 = Camera:WorldToViewportPoint(hitPoint)
                                if sp2.Z > 0 then
                                    local d2 = (fovOrigin.X - sp2.X) ^ 2
                                             + (fovOrigin.Y - sp2.Y) ^ 2
                                    if d2 <= fovSq
                                        and not hasWallBetween(Camera.CFrame.Position, part) then
                                        if d2 < bestDist then
                                            bestPlayer = p
                                            bestDist   = d2
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPlayer
end

function updateTarget()
    if not scriptActive then return end
    local myPos = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myPos then
        cachedTarget       = nil
        cachedTargetPoint  = nil
        cachedTargetPlayer = nil
        return
    end
    updateHitChanceRoll()
    if not currentHitChanceResult then
        cachedTarget       = nil
        cachedTargetPoint  = nil
        cachedTargetPlayer = nil
        return
    end
    local fovOrigin = getFOVOrigin(Config.FOVMode)

    if Config.AimMode == "Toggle" then
        if Config.LockedTarget then
            local p = Config.LockedTarget
            local shouldClear = false
            if not p or not p.Parent then shouldClear = true
            elseif isWhitelisted(p) then shouldClear = true
            elseif isOnSameTeam(p)  then shouldClear = true
            elseif Config.KnockedCheck and isKnockedRaw(p) then shouldClear = true end
            if shouldClear then
                Config.LockedTarget = nil
                Config.LockedPart   = nil
                cachedTarget       = nil
                cachedTargetPoint  = nil
                cachedTargetPlayer = nil
                if Config.SilentNotifications and Library then
                    Library:Notify("Silent: Lost target", 2)
                end
                return
            end
            if p.Character then
                local part, hitPoint = getClosestPartMultiToggle(p.Character, fovOrigin)
                if part and hitPoint then
                    if not Config.WallCheck
                        or not hasWallBetweenRaw(Camera.CFrame.Position, part) then
                        cachedTarget       = part
                        cachedTargetPoint  = hitPoint
                        cachedTargetPlayer = p
                        return
                    end
                    cachedTarget       = nil
                    cachedTargetPoint  = nil
                    cachedTargetPlayer = nil
                    return
                end
            end
            cachedTarget       = nil
            cachedTargetPoint  = nil
            cachedTargetPlayer = nil
            return
        end
        cachedTarget       = nil
        cachedTargetPoint  = nil
        cachedTargetPlayer = nil
        return
    end

    if Config.AimMode == "Hold" and not Config.SilentKeyHeld then
        cachedTarget       = nil
        cachedTargetPoint  = nil
        cachedTargetPlayer = nil
        return
    end

    local bestPart, bestPoint, bestDist, bestPlayer = nil, nil, math.huge, nil
    local players = Services.Players:GetPlayers()
    if Config.FOVMethod == "New FOV" then
        for _, player in ipairs(players) do
            if canTargetPlayer(player) then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (myPos.Position - hrp.Position).Magnitude
                    if dist <= Config.MaxDistance
                        and isMouseIn3DBox(player, fovOrigin, Config.FOVX, Config.FOVY, Config.FOVZ) then
                        local part, hitPoint = getClosestPartMulti(player.Character, fovOrigin)
                        if part and hitPoint and not hasWallBetween(Camera.CFrame.Position, part) then
                            if dist < bestDist then
                                bestPart   = part
                                bestPoint  = hitPoint
                                bestDist   = dist
                                bestPlayer = player
                            end
                        end
                    end
                end
            end
        end
    else
        local currentFov = getCurrentFOV()
        local fovSq      = currentFov * currentFov
        for _, player in ipairs(players) do
            if canTargetPlayer(player) then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (myPos.Position - hrp.Position).Magnitude
                    if dist <= Config.MaxDistance then
                        local sp = Camera:WorldToViewportPoint(hrp.Position)
                        if sp.Z > 0 then
                            local part, hitPoint = getClosestPartMulti(player.Character, fovOrigin)
                            if part and hitPoint then
                                local sp2 = Camera:WorldToViewportPoint(hitPoint)
                                if sp2.Z > 0 then
                                    local d2 = (fovOrigin.X - sp2.X) ^ 2
                                             + (fovOrigin.Y - sp2.Y) ^ 2
                                    if d2 <= fovSq
                                        and not hasWallBetween(Camera.CFrame.Position, part) then
                                        if d2 < bestDist then
                                            bestPart   = part
                                            bestPoint  = hitPoint
                                            bestDist   = d2
                                            bestPlayer = player
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    cachedTarget       = bestPart
    cachedTargetPoint  = bestPoint
    cachedTargetPlayer = bestPlayer
end

