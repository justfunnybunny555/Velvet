local function safeDisconnect(conn)
    if conn then
        pcall(function() conn:Disconnect() end)
    end
end

local function safeRemoveDrawing(d)
    if d then
        pcall(function() d:Remove() end)
    end
end

local function safeDestroy(inst)
    if inst then
        pcall(function() inst:Destroy() end)
    end
end

function isWhitelisted(player)
    if not player then return false end
    return Config.Whitelist.Players[player.Name] == true
end

function setWhitelistFromMulti(selected)
    Config.Whitelist.Players = {}
    if type(selected) == "table" then
        for name, isSel in pairs(selected) do
            if isSel then
                Config.Whitelist.Players[name] = true
            end
        end
    end
end

function getPlayerList()
    local list = {}
    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    table.sort(list)
    return list
end

function getHumanoid()
    if not LocalPlayer.Character then return nil end
    return LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
end

function getPingSeconds()
    local ok, ping = pcall(function()
        return tonumber(
            Services.Stats.Network.ServerStatsItem["Data Ping"]
                :GetValueString():match("%d+")
        ) or 80
    end)
    return (ok and ping or 80) / 1000
end

