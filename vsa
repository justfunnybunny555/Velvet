function hideESPObj(obj)
    if not obj then return end
    obj.Box.Visible    = false
    obj.Tracer.Visible = false
    obj.Name.Visible   = false
end

function updateESP()
    if not scriptActive then return end
    if not Config.ESP.Enabled then
        for _, obj in pairs(ESPCache) do hideESPObj(obj) end
        return
    end
    local camPos    = Camera.CFrame.Position
    local viewport  = Camera.ViewportSize
    local espTarget = getCurrentESPTarget()
    for player, obj in pairs(ESPCache) do
        local char = player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local valid = hrp and head and hum and hum.Health > 0
        if valid and Config.ESP.TeamCheck and LocalPlayer.Team and player.Team
            and LocalPlayer.Team == player.Team then
            valid = false
        end
        if valid and (camPos - hrp.Position).Magnitude > Config.ESP.MaxDistance then
            valid = false
        end
        if valid then
            local rootSP, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            local headSP = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
            local legSP  = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
            local isTargeted = Config.ESP.ShowTargetedColor and (espTarget == player)
            local activeBoxColor   = isTargeted and Config.ESP.TargetedColor or Config.ESP.BoxColor
            local activeEnemyColor = isTargeted and Config.ESP.TargetedColor or Config.ESP.EnemyColor
            local activeNameColor  = isTargeted and Config.ESP.TargetedColor or Config.ESP.NameColor

            if onScreen and rootSP.Z > 0 then
                local height = math.abs(headSP.Y - legSP.Y)
                local width  = height * 0.55
                if Config.ESP.Boxes then
                    obj.Box.Position  = Vector2.new(rootSP.X - width / 2, headSP.Y)
                    obj.Box.Size      = Vector2.new(width, height)
                    obj.Box.Color     = activeBoxColor
                    obj.Box.Thickness = isTargeted and 2 or 1
                    obj.Box.Visible   = true
                else
                    obj.Box.Visible = false
                end
                if Config.ESP.Tracer then
                    local origin
                    if Config.ESP.TracerOrigin == "Top" then
                        origin = Vector2.new(viewport.X / 2, 0)
                    elseif Config.ESP.TracerOrigin == "Mouse" then
                        origin = Services.UserInputService:GetMouseLocation()
                    else
                        origin = Vector2.new(viewport.X / 2, viewport.Y)
                    end
                    obj.Tracer.From      = origin
                    obj.Tracer.To        = Vector2.new(rootSP.X, legSP.Y)
                    obj.Tracer.Color     = activeEnemyColor
                    obj.Tracer.Thickness = isTargeted
                        and (Config.ESP.TracerThickness + 1)
                        or Config.ESP.TracerThickness
                    obj.Tracer.Visible   = true
                else
                    obj.Tracer.Visible = false
                end
                if Config.ESP.Names then
                    obj.Name.Text     = isTargeted and ("> " .. player.Name .. " <") or player.Name
                    obj.Name.Position = Vector2.new(rootSP.X, headSP.Y - 18)
                    obj.Name.Color    = activeNameColor
                    obj.Name.Visible  = true
                else
                    obj.Name.Visible = false
                end
            else
                hideESPObj(obj)
            end
        else
            hideESPObj(obj)
        end
    end
end

